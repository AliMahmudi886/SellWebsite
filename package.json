{
  "name": "iranian-shop-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs",
    "db:backup:prune": "node --env-file-if-exists=.env.local scripts/db-backup-prune.mjs",
    "db:privacy:retention": "node --env-file-if-exists=.env.local scripts/db-privacy-retention.mjs",
    "db:restore": "node --env-file-if-exists=.env.local scripts/db-restore.mjs",
    "db:restore:drill": "node --env-file-if-exists=.env.local scripts/db-restore-drill.mjs",
    "admin:hash": "node scripts/create-admin-hash.mjs",
    "smoke:db": "node --env-file-if-exists=.env.local scripts/smoke-db.mjs",
    "stress:recommendations": "node --env-file-if-exists=.env.local scripts/stress-recommendations.mjs",
    "smoke:upload": "node --env-file-if-exists=.env.local scripts/smoke-upload.mjs",
    "smoke:admin-security": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke-admin-security.mjs",
    "outbox:dispatch": "node --env-file-if-exists=.env.local scripts/order-outbox-worker.mjs",
    "outbox:watch": "node --env-file-if-exists=.env.local scripts/order-outbox-worker.mjs watch",
    "outbox:status": "node --env-file-if-exists=.env.local scripts/order-outbox-worker.mjs status",
    "outbox:requeue": "node --env-file-if-exists=.env.local scripts/order-outbox-worker.mjs requeue",
    "outbox:health": "node --env-file-if-exists=.env.local scripts/order-outbox-worker.mjs health",
    "db:backup:verify": "node scripts/db-backup-verify.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9.3"
  }
}
