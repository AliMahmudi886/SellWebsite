# Optional public origin for metadata and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public contact details. Leave blank until verified by the store owner.
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_INSTAGRAM_URL=
# Local PostgreSQL container (docker-compose.yml)
POSTGRES_DB=sellwebsite
POSTGRES_USER=sellwebsite
POSTGRES_PASSWORD=replace-with-a-random-local-secret
DATABASE_URL=postgresql://sellwebsite:replace-with-a-random-local-secret@localhost:5433/sellwebsite
DATABASE_SSL=false
# Admin access. Generate and save the hash with: npm run admin:hash
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Generate a unique random secret of at least 32 characters for signed sessions.
ADMIN_SESSION_SECRET=
# Set true only behind a proxy that appends the actual peer IP to X-Forwarded-For (or overwrites it).
TRUST_PROXY=false
# Number of trusted proxy hops from the server outward (1 for a single proxy).
TRUST_PROXY_HOPS=1

# Server-side admin sessions and MFA. Provision before deploying migration 011 and the new app.
# Base32 secret, at least 32 characters, from a trusted authenticator provisioning workflow.
ADMIN_TOTP_SECRET=
# SHA-256 digests of optional high-entropy 32-character lowercase hexadecimal recovery codes.
ADMIN_RECOVERY_CODE_HASHES=
# Allowed: owner, support, catalog, auditor. Omit to preserve full permissions for the existing administrator.
ADMIN_ROLE=owner
